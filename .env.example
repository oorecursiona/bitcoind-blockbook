# Copy via `scripts/btc.sh init <network>`, which fills in the network, ports and a
# random RPC password. Edit the rest by hand; `scripts/btc.sh up` applies changes.

# Prefix for containers; one project per network on a shared host.
COMPOSE_PROJECT_NAME=btc-testnet4
# mainnet | testnet (testnet3) | testnet4 | signet
NETWORK=testnet4
# Host directory for chain data: $DATA_DIR/bitcoind and $DATA_DIR/blockbook.
# Point it at the large SSD volume, e.g. /data/btc-testnet4.
DATA_DIR=./data

# ---- bitcoind ----
# Must have checksums in bitcoind/Dockerfile (31.1 and 29.2 do). 31.x is required for
# txospenderindex; 29.x is end of life.
BITCOIN_VERSION=31.1
RPC_USER=rpc
RPC_PASSWORD=
# UTXO cache in MiB. More makes the initial sync much faster; can be lowered after it.
BITCOIND_DBCACHE=2000
# Mempool size in MB. When full, bitcoind evicts the lowest-fee transactions and
# Blockbook stops seeing them. init sets it per network (mainnet 4096, test nets 2000).
BITCOIND_MAXMEMPOOL=2000
# 1 = maintain the output-spender index (Core 31+): `gettxspendingprevout` answers
# "which tx spent this outpoint" for confirmed spends too. Costs extra disk.
BITCOIND_TXOSPENDERINDEX=1
# Extra bitcoind flags, e.g. "-assumevalid=0 -blocksonly=1".
BITCOIND_EXTRA_ARGS=
# 0.0.0.0 accepts inbound peers (open the port in the firewall/security group);
# 127.0.0.1 keeps the node outbound-only.
P2P_BIND=0.0.0.0
BITCOIND_P2P_PORT=48333
# Host ports for RPC and ZMQ, always bound to 127.0.0.1.
BITCOIND_RPC_PORT=18029
BITCOIND_ZMQ_PORT=48329

# ---- blockbook ----
# Blockbook source to build. Default: the official release, fetched from GitHub by tag,
# so no local checkout is needed. Upgrade by changing the tag and running build.
# For development, point it at a local checkout instead, e.g. ../blockbook.
BLOCKBOOK_SRC=https://github.com/trezor/blockbook.git#v0.6.0
# 1 = link jemalloc, as upstream builds do after v0.6.0 (master, the oorecursiona fork).
BLOCKBOOK_JEMALLOC=0
IMAGE_TAG=latest
# 127.0.0.1 = reachable only from this host (front it with a reverse proxy);
# 0.0.0.0 = exposed directly.
BLOCKBOOK_BIND=127.0.0.1
BLOCKBOOK_PUBLIC_PORT=19129
BLOCKBOOK_INTERNAL_PORT=19029
# Bulk-sync parallelism; roughly the number of vCPUs.
BLOCKBOOK_WORKERS=8
# RocksDB block cache in bytes (1 GiB).
BLOCKBOOK_DBCACHE=1073741824
# 1 = fee estimates from mempool.space and fiat rates from CoinGecko where the coin
# config enables them; 0 = no outbound calls besides bitcoind.
BLOCKBOOK_EXTERNAL_APIS=1
BLOCKBOOK_EXTRA_ARGS=
# Set both to enable /admin on the internal port.
BB_ADMIN_USER=
BB_ADMIN_PASSWORD=
